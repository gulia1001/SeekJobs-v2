# Copy this file to .env and fill in your keys. Never commit .env.
# Used by the backend, the pipeline, and docker-compose.

# LLM for tailored CVs and match explanations — https://console.groq.com
GROQ_API_KEY=

# Optional: higher GitHub API rate limit + pinned repos
GITHUB_TOKEN=

# Optional: LinkedIn import via Apify (to be replaced by LinkedIn PDF upload)
APIFY_TOKEN=

# Optional: folder that contains final/ and interim/ (default: pipeline/data)
DATA_DIR=

# Sites allowed to call the API from a browser, comma-separated
# (default: http://localhost:3001,http://127.0.0.1:3001). In production: your real domain.
CORS_ORIGINS=

# Optional: TTF fonts for PDF CVs if no DejaVu/Arial is installed (needed for Cyrillic)
CV_FONT_REGULAR=
CV_FONT_BOLD=

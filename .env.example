# Copy this file to .env and fill in what you need. Never commit .env.
# Everything is optional — the app runs without any of these.

# LLM for AI-written tailored CVs and match explanations — https://console.groq.com
# Without it: matching, skill gaps, salaries and PDF/Word export still work;
# the CV uses your real data without AI rewriting.
GROQ_API_KEY=

# Optional: higher GitHub API rate limit + pinned repos
GITHUB_TOKEN=

# Jobs database. Empty = SQLite file pipeline/data/jobs.db (created by pipeline/run_daily.py).
# Example for Postgres: postgresql+psycopg://seekjobs:secret@localhost:5432/seekjobs
DATABASE_URL=

# Hide vacancies posted more than this many days ago (default 45)
JOB_MAX_AGE_DAYS=

# Docker only: password for the Postgres container (default seekjobs-local — change on servers)
POSTGRES_PASSWORD=

# Optional: folder with the older CSV dataset (final/, interim/) — default pipeline/data
DATA_DIR=

# Sites allowed to call the API from a browser, comma-separated
# (default: http://localhost:3001,http://127.0.0.1:3001). In production: your real domain.
CORS_ORIGINS=

# Optional: TTF fonts for PDF CVs if no DejaVu/Arial is installed (needed for Cyrillic)
CV_FONT_REGULAR=
CV_FONT_BOLD=
